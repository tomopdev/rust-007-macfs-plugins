# Git ať sám pozná textové soubory
* text=auto

# Rust a configy vždy LF, i na Windows
*.rs text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows bat soubory musí zůstat CRLF jinak nefungují
*.bat text eol=crlf
*.cmd text eol=crlf

# binárky nesahat
*.exe binary
*.dll binary
*.pdb binary
*.png binary
*.jpg binary